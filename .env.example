# ===================================================
# UNILIVE PRODUCTION ENVIRONMENT VARIABLES
# ===================================================

# 1. DATABASE (PostgreSQL - Neon.tech recommended)
# Pooler connection string for high-concurrency serverless executions
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP-HOST]-pooler.eu-central-1.aws.neon.tech/[DB_NAME]?sslmode=require"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[EP-HOST].eu-central-1.aws.neon.tech/[DB_NAME]?sslmode=require"

# 2. AUTHENTICATION & SECURITY
# Strong random secret (minimum 32 characters in production)
# Generate via: openssl rand -base64 32
JWT_SECRET="generate_a_minimum_32_characters_random_secret_for_production"

# 3. APPLICATION URLS
# Canonical production URL (HTTPS, no trailing slash)
NEXT_PUBLIC_APP_URL="https://unilive.app"
APP_URL="https://unilive.app"

# 4. TRANSACTIONAL EMAIL (Resend.com)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_sample_api_key_here"
EMAIL_FROM="UNILIVE <noreply@unilive.app>"

# 5. IMAGE UPLOADS & MEDIA STORAGE (Cloudinary)
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 6. REALTIME WEBSOCKETS (Pusher - Optional, polling fallback is active if empty)
# Obtain from https://pusher.com/channels
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# 7. ERROR MONITORING (Sentry - Optional, disabled if empty)
# SENTRY_DSN="https://sample@o123456.ingest.sentry.io/123456"
# NEXT_PUBLIC_SENTRY_DSN="https://sample@o123456.ingest.sentry.io/123456"
